{
  "name": "@sptos/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SPTOS backend — REST + WebSocket API, ETA engine and analytics.",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "reset": "node src/db/seed.js --reset",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@sptos/shared": "*",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.12.0",
    "pg": "8.23.0",
    "socket.io": "4.8.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "supertest": "7.2.2"
  }
}
