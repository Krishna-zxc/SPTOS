# ---------------------------------------------------------------------------
# SPTOS server configuration. Copy to `server/.env` and adjust.
# Every value below has a working default, so an empty .env still boots.
# ---------------------------------------------------------------------------

# HTTP port for the REST + WebSocket API.
PORT=4000

# Node environment: development | test | production
NODE_ENV=development

# PostgreSQL connection string.
# Leave EMPTY for zero-setup local development: the server then runs an
# embedded PostgreSQL (PGlite) with its data files under server/.pgdata/.
# Set it to a real Postgres (Neon / Supabase / Render free tier) for the pilot:
#   DATABASE_URL=postgresql://user:password@host:5432/sptos?sslmode=require
DATABASE_URL=

# Secret used to sign JWT access tokens.
# REQUIRED in production. In development a random secret is generated at boot
# (which invalidates existing tokens on every restart).
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins for CORS + WebSocket.
CORS_ORIGIN=http://localhost:5173

# --- Domain tuning (see PRD 15.2 "Open questions") -------------------------

# A commuter-facing status older than this is presented as "no recent data"
# instead of as live (PRD NFR: Transparency).
STALE_AFTER_SECONDS=480

# Minimum number of driver check-ins on a trip before an ETA is shown at all.
MIN_CHECKINS_FOR_ETA=1

# Minimum historical samples for a stop-to-stop segment before its measured
# average is trusted; below this the seeded scheduled time is used instead.
ETA_MIN_SAMPLES=3

# Fallback stop-to-stop travel time when neither history nor a scheduled
# time is available, in seconds.
ETA_FALLBACK_SEGMENT_SECONDS=180

# How many minutes ahead of arrival a subscribed commuter is alerted.
ARRIVAL_ALERT_MINUTES=5
